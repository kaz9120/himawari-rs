#!/usr/bin/env python3
"""himawari-rs の開発コマンドの入口。

`bin/` にパスを通すと `hmwr` として呼べる。リポジトリのどこから呼んでも、
このファイルの位置からリポジトリルートを決めるので動く。
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from hmwr.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
