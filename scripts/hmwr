#!/usr/bin/env python3
"""himawari-rsの日常操作をひとつの入口にまとめる（ADR-0179）。

**問題は入口が3系統に散っていたことではなく、系統ごとに世界観が違ったこと
である。** オプションを環境変数で渡すもの（`TRAIN_PEAK_LR`）とフラグで渡す
もの（`--apply`）、サブコマンドを持つもの（`fetch-dataset.sh`）と位置引数
だけのもの、ログを自分で書くものと呼び出し側が決めるものが混在していた。
覚える対象がコマンドの数だけあった。

このCLIが統一するのは4つである。

1. オプションはフラグで渡す。環境変数への変換はここが行う
2. 実験名を検証し、ログの置き場をここが決める（`data/logs/<領域>-<名前>.log`）
3. 外から見える操作と長時間の操作は `--dry-run` で下見できる
4. 終了コードはADR-0122の表に従う（0成功 / 1判定 / 2引数 / 3実行時）

**実処理は既存のスクリプトとバイナリへ委譲する。** shellが得意な仕事を
Pythonへ書き直す理由はなく、ADR-0122の言語の境界はそのまま残る。ここが
足すのは入口の一貫性と、複数手順をまとめた「正しい順番」である
（`hmwr sprt start` がbuild-pair→verify→起動を1コマンドにする）。
"""

from __future__ import annotations

import argparse
import os
import re
import shutil
import subprocess
import unicodedata
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
SCRIPTS = REPO / "scripts"

# 終了コード（ADR-0122）
EXIT_OK = 0
EXIT_JUDGE = 1
EXIT_USAGE = 2
EXIT_RUNTIME = 3

# 実験名。ログ・棋譜・バイナリのファイル名になるので、パス区切りと空白を弾く。
# ネット名はアンダースコアを含むため（`pairprod_2990M_q1`）、そこは許す
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")


class Fail(Exception):
    """メッセージと終了コードを持つ失敗。"""

    def __init__(self, message: str, code: int = EXIT_RUNTIME):
        super().__init__(message)
        self.code = code


def check_name(name: str) -> str:
    """実験名を検証する。ここを通った名前だけがファイル名になる。"""
    if not NAME_RE.match(name):
        raise Fail(
            f"実験名に使えない文字がある: {name!r}\n"
            "英数字で始め、英数字・ハイフン・アンダースコア・ドットだけを使う",
            EXIT_USAGE,
        )
    return name


def pad(text: str, width: int) -> str:
    """表示幅で右を埋める。全角は2桁と数える。"""
    w = sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in text)
    return text + " " * max(width - w, 1)


def rel(path: str | Path) -> str:
    """リポジトリの中のパスは相対で見せる。表示が長いと読み飛ばされる。"""
    s = str(path)
    prefix = f"{REPO}/"
    return s[len(prefix):] if s.startswith(prefix) else s


def log_path(area: str, name: str) -> Path:
    """ログの置き場を決める（ADR-0149）。呼び出し側は場所を決めない。"""
    d = REPO / "data" / "logs"
    d.mkdir(parents=True, exist_ok=True)
    return d / f"{area}-{name}.log"


def run(
    argv: list[str],
    *,
    dry_run: bool = False,
    env: dict[str, str] | None = None,
    log: Path | None = None,
    allowed: tuple[int, ...] = (0,),
) -> int:
    """外部コマンドを実行する。dry-runなら実行せずに表示する。"""
    shown = " ".join(rel(a) for a in argv)
    if env:
        prefix = " ".join(f"{k}={rel(v)}" for k, v in sorted(env.items()))
        shown = f"{prefix} {shown}"
    if dry_run:
        print(f"[dry-run] {shown}")
        if log:
            print(f"[dry-run] ログ: {rel(log)}")
        return EXIT_OK

    print(f"$ {shown}", flush=True)
    full_env = dict(os.environ)
    if env:
        full_env.update(env)

    if log is None:
        code = subprocess.call(argv, cwd=str(REPO), env=full_env)
    else:
        print(f"ログ: {rel(log)}", flush=True)
        with open(log, "ab") as fh:
            fh.write(f"\n=== {shown} ===\n".encode())
            proc = subprocess.Popen(
                argv,
                cwd=str(REPO),
                env=full_env,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
            )
            assert proc.stdout is not None
            for chunk in proc.stdout:
                sys.stdout.buffer.write(chunk)
                sys.stdout.flush()
                fh.write(chunk)
            code = proc.wait()

    if code not in allowed:
        raise Fail(f"失敗した（終了コード {code}）: {shown}", code)
    return code


def cargo_tool(binary: str, args: list[str]) -> list[str]:
    """crates/toolsのバイナリを走らせるコマンドを組み立てる。

    計測は `-C target-cpu=native` で行う（ADR-0003）。長い呪文を覚えずに
    済ませることがこの関数の目的である。
    """
    return [
        "cargo",
        "run",
        "--release",
        "-q",
        "-p",
        "himawari-tools",
        "--bin",
        binary,
        "--",
        *args,
    ]


_SHELL_DEFAULTS: dict[str, str] | None = None

# env.shが決める値のうち、Rust側のツールが読むもの。ここで既定値を持たない。
# **二重に持つと、env.shを直したときに片方が古くなる**（ADR-0149）
SHELL_KEYS = ("EVAL_FILE", "OPENINGS")


def shell_defaults() -> dict[str, str]:
    """env.shがマシンに合わせて決めた値を取り込む。

    `bench` と `verify` は評価関数を `EVAL_FILE` から読む（ADR-0122）。
    shellから呼ぶときは `source scripts/env.sh` が要ったが、CLIから呼ぶ
    ときにそれを覚えているのは無理がある。ここが肩代わりする。
    """
    global _SHELL_DEFAULTS
    if _SHELL_DEFAULTS is None:
        _SHELL_DEFAULTS = {}
        script = "source scripts/env.sh >/dev/null 2>&1 && " + "; ".join(
            f'printf "%s\\n" "${{{k}:-}}"' for k in SHELL_KEYS
        )
        try:
            out = subprocess.run(
                ["bash", "-c", script],
                cwd=str(REPO),
                capture_output=True,
                text=True,
                timeout=30,
            ).stdout.splitlines()
        except (OSError, subprocess.SubprocessError):
            out = []
        for key, value in zip(SHELL_KEYS, out):
            if value:
                _SHELL_DEFAULTS[key] = value
    return dict(_SHELL_DEFAULTS)


def native_env() -> dict[str, str]:
    """計測用の環境。RUSTFLAGSと、env.shが決めた評価関数の場所を入れる。"""
    env = {"RUSTFLAGS": os.environ.get("RUSTFLAGS", "-C target-cpu=native")}
    for key, value in shell_defaults().items():
        # 呼び出し側が明示していればそちらを優先する
        if key not in os.environ:
            env[key] = value
    return env


# --- env ---------------------------------------------------------------


def cmd_env(args: argparse.Namespace) -> int:
    """env.shが決めた値を表示する。条件を確かめてから測るための入口。"""
    script = "source scripts/env.sh && env_summary"
    return run(["bash", "-c", script], dry_run=args.dry_run)


# --- sprt --------------------------------------------------------------


def sprt_paths(name: str) -> dict[str, Path]:
    return {
        "base": REPO / "data" / "bin" / f"base-{name}",
        "cand": REPO / "data" / "bin" / f"cand-{name}",
        "jsonl": REPO / "data" / "sprt" / f"{name}.jsonl",
        "result": REPO / "data" / "sprt" / f"{name}.result",
        "log": log_path("sprt", name),
    }


def cmd_sprt_start(args: argparse.Namespace) -> int:
    """build-pair → verify → 切り離し起動を1コマンドで行う。

    3つを別々に叩くと順番を飛ばせてしまう。verifyを飛ばすと、探索に影響の
    ない変更へ対局リソースを払う（ADR-0074）。ここに順番を固定する。
    """
    name = check_name(args.name)
    p = sprt_paths(name)

    if p["result"].is_file():
        print(f"判定済み: {p['result']}")
        print(p["result"].read_text(encoding="utf-8"), end="")
        return EXIT_OK

    build = [str(SCRIPTS / "build-pair.sh"), name]
    if args.baseline:
        build.append(args.baseline)
    run(build, dry_run=args.dry_run)

    if args.verify:
        code = run(
            cargo_tool("verify", [str(p["base"]), str(p["cand"])]),
            dry_run=args.dry_run,
            env=native_env(),
            log=log_path("verify", name),
            allowed=(0, 1),
        )
        if code == EXIT_JUDGE:
            # 全局面でノード数が一致した。探索に影響していない（ADR-0074）
            print()
            print("全局面でノード数が一致した。この変更は探索に影響していない。")
            print("SPRTにかけても中立にしかならないので起動しない。")
            print("終盤にしか出ない機能なら、終盤局面を別に用意して測り直す。")
            print("それでも走らせるなら --no-verify を付ける。")
            return EXIT_JUDGE

    env_args: list[str] = []
    if args.noninferiority:
        # 参照追従で「害がなければ入れたい」変更（ADR-0163）
        env_args += ["SPRT_ELO0=-5", "SPRT_ELO1=0"]
    if args.tc:
        env_args.append(f"SPRT_TC={args.tc}")
    for item in args.set or []:
        if "=" not in item:
            raise Fail(f"--set はKEY=VALUEで書く: {item}", EXIT_USAGE)
        env_args.append(item)

    detach = [
        str(SCRIPTS / "sprt-detach.py"),
        str(p["base"]),
        str(p["cand"]),
        name,
        *env_args,
    ]
    run(detach, dry_run=args.dry_run)
    if not args.dry_run:
        print()
        print(f"経過: hmwr sprt status {name}")
        print(f"完了: {p['result']} の出現を見る")
    return EXIT_OK


def cmd_sprt_status(args: argparse.Namespace) -> int:
    """途中経過を出す。名前を省くと未完了の走行を並べる。"""
    if args.name:
        name = check_name(args.name)
        p = sprt_paths(name)
        if not p["log"].is_file():
            raise Fail(f"ログがない: {p['log']}")
        return run(
            [sys.executable, str(SCRIPTS / "sprt-summary.py"), str(p["log"]), name],
            dry_run=args.dry_run,
            allowed=(0, 1, 2),
        )

    sprt_dir = REPO / "data" / "sprt"
    if not sprt_dir.is_dir():
        print("走行はまだない")
        return EXIT_OK

    # 完了は .result の有無で決まる（ADR-0175）。プロセスの生死は見ない。
    # 「未完了」には、判定前に打ち切った過去の走行も含まれる
    rows = []
    for jsonl in sorted(sprt_dir.glob("*.jsonl")):
        name = jsonl.stem
        done = (sprt_dir / f"{name}.result").is_file()
        games = sum(1 for _ in jsonl.open("rb"))
        rows.append((jsonl.stat().st_mtime, name, "完了" if done else "未完了", games))
    if not rows:
        print("走行はまだない")
        return EXIT_OK

    rows.sort(reverse=True)
    shown = rows if args.all else rows[:10]
    print(pad("名前", 34) + pad("状態", 8) + "局数")
    for _, name, state, games in shown:
        print(pad(name, 34) + pad(state, 8) + str(games))
    if not args.all and len(rows) > len(shown):
        print(f"\n新しい順に{len(shown)}件。全{len(rows)}件を見るには --all")
    return EXIT_OK


# --- build -------------------------------------------------------------


def cmd_build_pair(args: argparse.Namespace) -> int:
    name = check_name(args.name)
    argv = [str(SCRIPTS / "build-pair.sh"), name]
    if args.baseline:
        argv.append(args.baseline)
    return run(argv, dry_run=args.dry_run)


def cmd_build_pgo(args: argparse.Namespace) -> int:
    argv = [str(SCRIPTS / "build-pgo.sh")]
    if args.out:
        argv.append(args.out)
    return run(argv, dry_run=args.dry_run)


# --- verify / bench ----------------------------------------------------


def cmd_verify(args: argparse.Namespace) -> int:
    """機能検証（ADR-0074）。全局面で一致したら終了コード1を返す。

    引数が1つでファイルとして存在しなければ実験名とみなし、
    `data/bin/base-<名前>` と `cand-<名前>` を比べる。
    """
    given = args.targets
    if len(given) == 1 and not Path(given[0]).is_file():
        name = check_name(given[0])
        p = sprt_paths(name)
        for path in (p["base"], p["cand"]):
            if not path.is_file() and not args.dry_run:
                raise Fail(
                    f"バイナリがない: {rel(path)}\nhmwr build pair {name} で作る"
                )
        targets = [str(p["base"]), str(p["cand"])]
        log = log_path("verify", name)
    else:
        targets = given
        log = log_path("verify", check_name(args.log)) if args.log else None

    extra: list[str] = []
    if args.depth:
        extra += ["--depth", str(args.depth)]
    if args.eval_file:
        extra += ["--eval-file", args.eval_file]
    return run(
        cargo_tool("verify", [*targets, *extra]),
        dry_run=args.dry_run,
        env=native_env(),
        log=log,
        allowed=(0, 1),
    )


def cmd_bench(args: argparse.Namespace) -> int:
    extra: list[str] = []
    if args.depth:
        extra += ["--depth", str(args.depth)]
    if args.nodes:
        extra += ["--nodes", str(args.nodes)]
    if args.runs:
        extra += ["--runs", str(args.runs)]
    if args.eval_file:
        extra += ["--eval-file", args.eval_file]
    log = log_path("bench", check_name(args.log)) if args.log else None
    return run(
        cargo_tool("bench", [*args.binaries, *extra]),
        dry_run=args.dry_run,
        env=native_env(),
        log=log,
    )


# --- train / eval / quiet ----------------------------------------------


def cmd_train(args: argparse.Namespace) -> int:
    """本番規模の学習（ADR-0149）。オプションは環境変数へここで畳む。"""
    name = check_name(args.name)
    env: dict[str, str] = {}
    if args.init_ckpt:
        env["TRAIN_INIT_CKPT"] = args.init_ckpt
    if args.lr:
        env["TRAIN_PEAK_LR"] = args.lr
    if args.warmup:
        env["TRAIN_WARMUP"] = str(args.warmup)
    if args.device:
        env["TRAIN_DEVICE"] = args.device
    if args.seed is not None:
        env["TRAIN_SEED"] = str(args.seed)
    if args.notes:
        env["TRAIN_NOTES"] = args.notes
    if args.extra:
        env["TRAIN_EXTRA_ARGS"] = args.extra

    argv = [str(SCRIPTS / "train-net.sh"), name, args.data]
    if args.valid:
        argv.append(args.valid)
    return run(argv, dry_run=args.dry_run, env=env)


def cmd_eval(args: argparse.Namespace) -> int:
    """ネットの検証損失を測る。**採否は対局で決める**（ADR-0136）。"""
    env: dict[str, str] = {}
    if args.valid:
        env["EVAL_VALIDS"] = args.valid
    return run(
        [str(SCRIPTS / "eval-net.sh"), *args.nets],
        dry_run=args.dry_run,
        env=env,
    )


def cmd_quiet(args: argparse.Namespace) -> int:
    """教師局面をqsearchの静止局面へ置き換える（ADR-0136）。"""
    env: dict[str, str] = {}
    if args.max_plies is not None:
        env["QUIET_MAX_PLIES"] = str(args.max_plies)
    if args.limit is not None:
        env["QUIET_LIMIT"] = str(args.limit)
    argv = [str(SCRIPTS / "quiet.sh"), args.input, args.output]
    if args.name:
        argv.append(check_name(args.name))
    return run(argv, dry_run=args.dry_run, env=env)


# --- data / floodgate / release / doc ----------------------------------


def cmd_data_fetch(args: argparse.Namespace) -> int:
    return run(
        [str(SCRIPTS / "fetch-dataset.sh"), args.stage],
        dry_run=args.dry_run,
    )


def cmd_floodgate_cycle(args: argparse.Namespace) -> int:
    env: dict[str, str] = {}
    if args.seed_max is not None:
        env["SEED_MAX"] = str(args.seed_max)
    argv = [str(SCRIPTS / "floodgate-cycle.sh")]
    if args.year:
        argv.append(str(args.year))
    return run(argv, dry_run=args.dry_run, env=env)


def cmd_release(args: argparse.Namespace) -> int:
    """GitHub Releaseを作る。**既定は予行演習で、--apply で実際に作る**。"""
    script = SCRIPTS / f"release-{args.kind}.sh"
    argv = [str(script), args.file, str(args.version)]
    if args.notes:
        argv.append(args.notes)
    if args.apply:
        argv.append("--apply")
    return run(argv, dry_run=args.dry_run)


def cmd_doc_lint(args: argparse.Namespace) -> int:
    """日本語文書のlint（ADR-0178）。CIと同じものをローカルで回す。"""
    if shutil.which("npm") is None:
        raise Fail("npm がない。Node 22以降を入れる")
    if not (REPO / "node_modules").is_dir() and not args.dry_run:
        run(["npm", "ci"], dry_run=args.dry_run)
    target = "lint:fix" if args.fix else "lint"
    return run(["npm", "run", target], dry_run=args.dry_run)


# --- 引数の組み立て ----------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="hmwr",
        description="himawari-rsの日常操作をまとめた入口（ADR-0179）",
        epilog="詳細は docs/adr/0179-hmwr-cli.md と CLAUDE.md にある。",
    )
    p.add_argument(
        "--dry-run",
        action="store_true",
        help="実行せず、走るはずのコマンドを表示する",
    )
    sub = p.add_subparsers(dest="command", metavar="<コマンド>")

    # env
    s = sub.add_parser("env", help="並列度・評価関数・持ち時間の既定を表示する")
    s.set_defaults(func=cmd_env)

    # sprt
    s = sub.add_parser("sprt", help="対局ゲート（ADR-0028・0154・0175）")
    ss = s.add_subparsers(dest="sub", metavar="<操作>")

    t = ss.add_parser(
        "start",
        help="ペアを作り、機能検証を通してから切り離して起動する",
        description="build-pair → verify → 切り離し起動を1コマンドで行う。"
        "判定が出るまで走り、落ちても棋譜から再開する。",
    )
    t.add_argument("name", help="実験名。adrNNNN-<slug> を使う")
    t.add_argument("--baseline", help="baselineのref（既定 origin/main）")
    t.add_argument(
        "--noninferiority",
        action="store_true",
        help="非劣性で測る（elo0=-5、elo1=0。ADR-0163）",
    )
    t.add_argument("--tc", help="持ち時間（既定 10+0.1）")
    t.add_argument(
        "--set",
        action="append",
        metavar="KEY=VALUE",
        help="SPRT_* を直接渡す（繰り返し可）",
    )
    t.add_argument(
        "--no-verify",
        dest="verify",
        action="store_false",
        help="機能検証を飛ばす。終盤にしか出ない機能を測るときだけ使う",
    )
    t.set_defaults(func=cmd_sprt_start, verify=True)

    t = ss.add_parser("status", help="途中経過を出す。名前を省くと走行中を並べる")
    t.add_argument("name", nargs="?", help="実験名")
    t.add_argument("--all", action="store_true", help="完了した走行も並べる")
    t.set_defaults(func=cmd_sprt_status)

    # build
    s = sub.add_parser("build", help="対局・計測用のビルド")
    ss = s.add_subparsers(dest="sub", metavar="<操作>")

    t = ss.add_parser("pair", help="baseline/candidateの2本を同条件で作る")
    t.add_argument("name", help="実験名")
    t.add_argument("--baseline", help="baselineのref（既定 origin/main）")
    t.set_defaults(func=cmd_build_pair)

    t = ss.add_parser("pgo", help="PGOで配布・対局用の単体ビルドを作る")
    t.add_argument("--out", help="出力先（既定 data/bin/himawari-pgo）")
    t.set_defaults(func=cmd_build_pgo)

    # verify
    s = sub.add_parser(
        "verify",
        help="機能検証（ADR-0074）。全局面で一致したら終了コード1",
    )
    s.add_argument(
        "targets",
        nargs="+",
        metavar="<名前 | バイナリ...>",
        help="実験名を1つ渡すと data/bin/base-<名前> と cand-<名前> を比べる。"
        "バイナリを2つ並べて直接比べてもよい",
    )
    s.add_argument("--depth", type=int, help="探索の深さ（既定 13）")
    s.add_argument("--eval-file", help="評価関数のパス")
    s.add_argument("--log", help="ログ名。data/logs/verify-<名前>.log へ残す")
    s.set_defaults(func=cmd_verify)

    # bench
    s = sub.add_parser("bench", help="固定深さでNPSを測る（ADR-0081）")
    s.add_argument("binaries", nargs="+", help="測るバイナリ。2本以上で交互に測る")
    s.add_argument("--depth", type=int, help="探索の深さ（既定 19）")
    s.add_argument("--nodes", type=int, help="深さの代わりにノード数で打ち切る")
    s.add_argument("--runs", type=int, help="1本を何周測るか")
    s.add_argument("--eval-file", help="評価関数のパス")
    s.add_argument("--log", help="ログ名。data/logs/bench-<名前>.log へ残す")
    s.set_defaults(func=cmd_bench)

    # train
    s = sub.add_parser("train", help="本番規模のネットを学習する（ADR-0149）")
    s.add_argument("name", help="ネット名。ログと台帳の名前にもなる")
    s.add_argument("--data", required=True, help="学習データ（psv）")
    s.add_argument(
        "--valid",
        help="検証データ。**学習データと同じ土俵に揃える**（ADR-0136）",
    )
    s.add_argument("--init-ckpt", help="継続学習の初期値（ADR-0145）")
    s.add_argument("--lr", help="peak_lr。継続学習の既定は1e-4")
    s.add_argument("--warmup", type=int, help="warmupステップ数")
    s.add_argument("--device", help="mps か cpu（既定 mps）")
    s.add_argument("--seed", type=int, help="乱数種（既定 0）")
    s.add_argument("--notes", help="実験台帳へ書く備考")
    s.add_argument(
        "--extra",
        help="train.pyへ素通しする追加引数。ハイフンで始まる値は "
        "--extra=--mirror-factor のように = でつなぐ",
    )
    s.set_defaults(func=cmd_train)

    # eval
    s = sub.add_parser("eval", help="ネットの検証損失を測る")
    s.add_argument("nets", nargs="+", help="ネット（.hmwr / .ckpt）")
    s.add_argument("--valid", help="検証集合。土俵を跨ぐときはコンマ区切り")
    s.set_defaults(func=cmd_eval)

    # quiet
    s = sub.add_parser("quiet", help="教師局面を静止局面へ置き換える（ADR-0136）")
    s.add_argument("input", help="入力psv")
    s.add_argument("output", help="出力psv")
    s.add_argument("--name", help="ログ名。省くと出力ファイル名から作る")
    s.add_argument("--max-plies", type=int, help="進める手数の上限（既定 1）")
    s.add_argument("--limit", type=int, help="先頭のこの件数だけ処理する")
    s.set_defaults(func=cmd_quiet)

    # data
    s = sub.add_parser("data", help="教師データの取得と前処理")
    ss = s.add_subparsers(dest="sub", metavar="<操作>")
    t = ss.add_parser("fetch", help="HuggingFaceから取得してpsvを作る")
    t.add_argument(
        "stage",
        nargs="?",
        default="all",
        choices=["download", "verify", "prepare", "all"],
        help="段（既定 all）",
    )
    t.set_defaults(func=cmd_data_fetch)

    # floodgate
    s = sub.add_parser("floodgate", help="実戦棋譜の定点観測（ADR-0152）")
    ss = s.add_subparsers(dest="sub", metavar="<操作>")
    t = ss.add_parser("cycle", help="回収→分析→定跡追加→網羅率を回す")
    t.add_argument("--year", type=int, help="対象年（既定 2026）")
    t.add_argument("--seed-max", type=int, help="1回の定跡追加数（既定 50）")
    t.set_defaults(func=cmd_floodgate_cycle)

    # release
    s = sub.add_parser(
        "release",
        help="ネット・定跡をGitHub Releaseで配る。既定は予行演習",
    )
    s.add_argument("kind", choices=["net", "book"], help="配るもの")
    s.add_argument("file", help="ファイル")
    s.add_argument("version", type=int, help="バージョン番号")
    s.add_argument("--notes", help="リリースノートへの追記")
    s.add_argument(
        "--apply",
        action="store_true",
        help="実際に作る。付けないと走るコマンドを出して終わる",
    )
    s.set_defaults(func=cmd_release)

    # doc
    s = sub.add_parser("doc", help="文書")
    ss = s.add_subparsers(dest="sub", metavar="<操作>")
    t = ss.add_parser("lint", help="日本語文書のlint（ADR-0178）")
    t.add_argument("--fix", action="store_true", help="自動で直せるものを直す")
    t.set_defaults(func=cmd_doc_lint)

    return p


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if not getattr(args, "func", None):
        parser.print_help()
        return EXIT_USAGE
    try:
        return args.func(args)
    except Fail as e:
        print(f"エラー: {e}", file=sys.stderr)
        return e.code
    except KeyboardInterrupt:
        print("\n中断した", file=sys.stderr)
        return EXIT_RUNTIME


if __name__ == "__main__":
    sys.exit(main())
