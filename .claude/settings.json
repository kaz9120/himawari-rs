{
  "permissions": {
    "allow": [
      "Bash(hmwr --dry-run:*)",
      "Bash(hmwr bench:*)",
      "Bash(hmwr book stats:*)",
      "Bash(hmwr ci wait:*)",
      "Bash(hmwr data stats:*)",
      "Bash(hmwr doc check:*)",
      "Bash(hmwr doc lint:*)",
      "Bash(hmwr status:*)",
      "Bash(hmwr exp check:*)",
      "Bash(hmwr exp report:*)",
      "Bash(hmwr exp show:*)",
      "Bash(hmwr kifu rate:*)",
      "Bash(hmwr league summary:*)",
      "Bash(hmwr match show:*)",
      "Bash(hmwr match wait:*)",
      "Bash(hmwr net eval:*)",
      "Bash(hmwr profile report:*)",
      "Bash(hmwr queue status:*)",
      "Bash(hmwr sprt show:*)",
      "Bash(hmwr sprt wait:*)",
      "Bash(hmwr spsa show:*)",
      "Bash(hmwr pr template:*)",
      "Bash(hmwr verify:*)",
      "Bash(./bin/hmwr --dry-run:*)",
      "Bash(./bin/hmwr ci wait:*)",
      "Bash(./bin/hmwr data stats:*)",
      "Bash(./bin/hmwr doc check:*)",
      "Bash(./bin/hmwr doc lint:*)",
      "Bash(./bin/hmwr exp check:*)",
      "Bash(./bin/hmwr exp report:*)",
      "Bash(./bin/hmwr exp show:*)",
      "Bash(./bin/hmwr kifu rate:*)",
      "Bash(./bin/hmwr match show:*)",
      "Bash(./bin/hmwr match wait:*)",
      "Bash(./bin/hmwr queue status:*)",
      "Bash(./bin/hmwr sprt show:*)",
      "Bash(./bin/hmwr sprt wait:*)",
      "Bash(./bin/hmwr spsa show:*)",
      "Bash(./bin/hmwr pr template:*)",
      "Bash(./bin/hmwr status:*)",
      "Bash(awk *)",
      "Bash(cargo bench:*)",
      "Bash(cargo build:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo run --release -p himawari-tools --bin verify:*)",
      "Bash(cargo test:*)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git filter-branch:*)",
      "Bash(rm -r data:*)",
      "Bash(rm -rf data:*)",
      "Edit(Cargo.toml)",
      "Write(Cargo.toml)"
    ],
    "deny": [
      "Bash(git push origin main:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no_direct_tools.py",
            "statusMessage": "道具の直接実行を検査中",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" || { echo \"rustfmtを検査できなかった（$CLAUDE_PROJECT_DIR へ移れない）\" >&2; exit 0; }; cargo fmt --check || { echo 'cargo fmt が通っていない。cargo fmt を実行してからコミットする（CLAUDE.md「コミット規律」）' >&2; exit 2; }",
            "statusMessage": "rustfmtを検査中",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check_commits.sh parens",
            "statusMessage": "コミット本文を検査中",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check_commits.sh subject",
            "statusMessage": "コミット件名を検査中",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
